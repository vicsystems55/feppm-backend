NODE_ENV=development
PORT=5000
# Local PostgreSQL. Create the `feppm` database and replace YOUR_PASSWORD.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/feppm?schema=public"
# Prisma migrations use a direct connection. Locally this can match DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/feppm?schema=public"
DATABASE_CONNECTION_LIMIT=2
DATABASE_POOL_TIMEOUT=20
# Used only by the controlled MySQL-to-PostgreSQL transfer utility.
MYSQL_SOURCE_URL="mysql://root:@127.0.0.1:3306/feppm"
MIGRATION_BATCH_SIZE=250
# Interactive checklist submission transaction timeout in milliseconds.
CHECKLIST_TRANSACTION_TIMEOUT_MS=20000
# Mobile evidence must be captured within this distance of the facility.
EVIDENCE_GEOFENCE_RADIUS_METERS=250
EVIDENCE_MAX_GPS_ACCURACY_METERS=100
# Demo mode: keep distance verification and watermarking but do not reject.
EVIDENCE_GEOFENCE_ENFORCED=false
# Optional dedicated signing secret. JWT_SECRET is used when omitted.
# EVIDENCE_VERIFICATION_SECRET=replace-with-a-long-random-value

# Cloudinary destination for GPS-verified mobile evidence.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
CLOUDINARY_UPLOAD_FOLDER=feppm/photos

# Supabase production examples (copy the exact values from Project > Connect):
# Runtime: Supavisor session pooler for a persistent IPv4 Render service.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Migrations: direct endpoint where IPv6 is available; otherwise use session mode.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=feppm-api
JWT_AUDIENCE=feppm-web
REFRESH_COOKIE_NAME=feppm_refresh_token
REFRESH_COOKIE_MAX_AGE_MS=604800000
CLIENT_URL=http://localhost:5173
# Public Vue application URL used in ticket email buttons.
APP_URL=http://localhost:5173
# For multiple allowed web origins, use a comma-separated allowlist instead:
# CLIENT_URLS=https://feppm.netlify.app,http://localhost:5173

# Resend transactional email. Leave the API key blank to disable email locally.
EMAIL_NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL="FEPPM Support <notifications@feppm.erp-55.com.ng>"
# Optional monitored mailbox. Replies go here instead of the sending address.
RESEND_REPLY_TO=support@feppm.erp-55.com.ng
# Only needed when running `npm run email:test`.
TEST_EMAIL_TO=your-email@example.com
# Redirect notifications intended for .demo login addresses to TEST_EMAIL_TO.
# Keep false in production once accounts have real email addresses.
EMAIL_DEMO_FALLBACK_ENABLED=true

# Optional override used by the development seed script.
# DEMO_USER_PASSWORD=Demo@FEPPM2026
