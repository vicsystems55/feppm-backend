NODE_ENV=development
PORT=5000
# XAMPP/MySQL default: root user with an empty password.
DATABASE_URL="mysql://root:@127.0.0.1:3306/feppm"

# Clever Cloud format (replace with the values from the MySQL add-on):
# DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME"
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=feppm-api
JWT_AUDIENCE=feppm-web
REFRESH_COOKIE_NAME=feppm_refresh_token
REFRESH_COOKIE_MAX_AGE_MS=604800000
CLIENT_URL=http://localhost:5173

# Optional override used by the development seed script.
# DEMO_USER_PASSWORD=Demo@FEPPM2026
